# Workbook templates are JSON; tell GitHub to highlight and diff them as such.
*.workbook linguist-language=JSON text eol=lf

# Keep generated and source files on LF so diffs stay clean across platforms.
*.md text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.json text eol=lf

# The catalog is generated by scripts/build_catalog.py.
CATALOG.md linguist-generated=true
